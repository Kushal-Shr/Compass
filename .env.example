CANVAS_BASE_URL=https://your-school.instructure.com
CANVAS_TOKEN=
# Leave unset locally: the SDK uses your `ant auth login` sign-in.
# Set it only in GitHub Actions secrets.
# ANTHROPIC_API_KEY=
# The OAuth client file downloaded from Google Cloud (APIs & Services → Credentials).
# Keep it in the repo root; .gitignore ignores client_secret_*.json.
GOOGLE_CLIENT_FILE=client_secret_XXXX.json
